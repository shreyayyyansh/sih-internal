# Vertex AI service account key (relative paths resolve from agents/)
GOOGLE_APPLICATION_CREDENTIALS=../server/serviceAccountKey.json
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_PROJECT= (optional; defaults to the key file's project_id)
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_ENDPOINT='https://api.smith.langchain.com'
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT='CityOS'
BACKEND_URL=http://localhost:3000
AUTH0_AUDIENCE=https://CityOS/api
AUTH0_DOMAIN="your_auth0_domain_here"
TAVILY_API_KEY="your_tavily_api_key_here"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>"
MONGO_DB_NAME="your_db_name_here"

# --- Graph RAG Scoring Weights ---
SCORE_W_VECTOR=0.40
SCORE_W_GRAPH=0.30
SCORE_W_REPUTATION=0.20
SCORE_W_RECENCY=0.10
GRAPH_RADIUS_KM=10.0
TRAJ_ALPHA=0.30
RERANKER_TOP_N=20
